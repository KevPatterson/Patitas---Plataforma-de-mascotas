# ── CLIENTE (Vite - expuestas al navegador, seguras con RLS) ──
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SITE_URL=https://patitass.vercel.app

# ── SERVIDOR (Vercel Functions - NUNCA con prefijo VITE_) ────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_SECRET_KEY=

# ── IA Provider (elegir uno) ─────────────────────────────────────
AI_PROVIDER=MOCK # MOCK | CLOUDFLARE | OPENAI

# Cloudflare AI (si AI_PROVIDER=CLOUDFLARE)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# OpenAI (si AI_PROVIDER=OPENAI)
OPENAI_API_KEY=

# Internal API Key (para workers/cron)
INTERNAL_API_KEY=

# ── DB pooling (solo servidor, opcional) ─────────────────────────
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_PRISMA_URL=
POSTGRES_HOST=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=
